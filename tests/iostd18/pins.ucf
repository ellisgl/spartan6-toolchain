# LVCMOS18 in bank 0 (the LED pins and two header pins); drives legal in bank 0.
NET "i<0>" LOC = P140 | IOSTANDARD = LVCMOS18;
NET "i<1>" LOC = P141 | IOSTANDARD = LVCMOS18;
NET "o<0>" LOC = P134 | IOSTANDARD = LVCMOS18 | DRIVE = 2 | SLEW = SLOW;
NET "o<1>" LOC = P133 | IOSTANDARD = LVCMOS18 | DRIVE = 4 | SLEW = FAST;
NET "o<2>" LOC = P132 | IOSTANDARD = LVCMOS18 | DRIVE = 6 | SLEW = SLOW;
NET "o<3>" LOC = P131 | IOSTANDARD = LVCMOS18 | DRIVE = 8 | SLEW = FAST;
NET "o<4>" LOC = P127 | IOSTANDARD = LVCMOS18 | DRIVE = 12 | SLEW = SLOW;
NET "o<5>" LOC = P126 | IOSTANDARD = LVCMOS18 | DRIVE = 16 | SLEW = FAST;
NET "o<6>" LOC = P124 | IOSTANDARD = LVCMOS18 | DRIVE = 2 | SLEW = SLOW;
NET "o<7>" LOC = P123 | IOSTANDARD = LVCMOS18 | DRIVE = 4 | SLEW = FAST;
